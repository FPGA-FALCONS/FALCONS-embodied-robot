// ============================================================================
// falcons.cst —— FALCONS-embodied-robot 整车管脚约束
//
// 器件：GW5AT-138B（GW5AT-LV138PG484AC1/I0），ACG720 开发板
//
// ★ 引脚来源与依据（逐针抄录，不靠"相邻引脚递增"推测）
//   1. 电机/编码器 21 根：逐针抄自 class\car_fpga\constr\motor_test.cst
//      该文件已按《ACG720_引脚接线手册_RevI.pdf》逐针复核（J4/J5 排线直连）
//   2. 板载时钟/按键/串口/LED：手册 §2.3 板载资源表
//   3. HDMI：模块库 modules\hdmi_1024x600\constraints\acg720_hdmi.cst
//      （DVI_TX_Top 内部创建 LVDS25 输出单元，故只需 IO_LOC）
//   4. 遥控 6 路（J6 整排）：D19 E19 E18 F18 F20 F19
//      （引脚依据 ai 优化版 §2.4 的板卡引脚表；需求原文 37 行里没有章节号）
//      应用映射以 rtl/rc/ht10a_input.v 和 doc/HT10A接线与验收.md 为准：
//        J6.1/bit0=CH4转向；J6.2/bit1=CH2油门；J6.3/bit2=CH5/SWA确认/返回；
//        J6.4/bit3=CH7/SWC手动/光标；J6.5/bit4=CH6/SWB录音；J6.6/bit5=CH8/select。
//      六路均参与整车有效性判定（SIG_VALID_MASK=111111）。
//      通用模块默认011111仅用于独立配置/测试，不可覆盖整车值。
//      CH_*参数是零起始J6槽位索引，不能与接收机CH号混淆。
//      ★ 电平待确认：6 路统一 3.3 V bank + 上拉；接收机经**电平转换模块**接入，
//        模块型号/输出电平**未实测**（输出 >3.3 V 有过压风险；若为开漏则必须保留上拉）
//        —— 见 doc\HT10A接线与验收.md §2/§6 的实测表。
//   5. 雷达 RX：C14 = J3.3（★ 详见下方说明）
//   6. ToF：J7 排针（SDA=E17 / SCL=F16 / INT=C20 / SHUT=D20）；模块未做出，四线置安全空闲态
//
// ★★ 雷达绝对不要接 A15 ★★
//   A15 = J2.6 = IMU 的 CS；J1 与 J2 是**同一条网络**，两个输出挂一起会"对打"，
//   可能损坏 IO 或表现为 IMU / 雷达随机失效。模块库 M10 示例写 A15 是
//   "不装 IMU 时的独立飞线选脚"，本车 IMU 必装 → 必须用 C14。
//
// ★ 接线纪律（上电前逐条核对）
//   - 灰排线按 Pin 号核对两端，确认 Pin1（母头与公针是镜像的，插反 = 整排错位，综合查不出）
//   - J1 与 Jx.y 是同一网络，接线二选一
//   - 电机 13 根输出全部 PULL_MODE=DOWN + STBY 加 10 kΩ 下拉 + 拔掉驱动板 STBY 跳线帽
//   - 地线单点汇合（J5 pin2），星形接地；电机电流不进 FPGA 地
//   - GPIO0 bank 跳线必须 3.3 V
// ============================================================================

// ---------------- 系统时钟 ----------------
IO_LOC  "i_clk_50m" Y18;                                   // FPGA_GCLK1，50 MHz
IO_PORT "i_clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ---------------- 板载按键（低有效）----------------
IO_LOC  "i_key_reset_n" F15;                               // S0 复位
IO_PORT "i_key_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_key1_n" A20;                                    // S1 启动 / 停止
IO_PORT "i_key1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_key2_n" B20;                                    // S2 计数清零 + 堵转清除
IO_PORT "i_key2_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_key3_n" A21;                                    // S3 切换界面页面
IO_PORT "i_key3_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_key4_n" B21;                                    // S4 急停（锁存切换）
IO_PORT "i_key4_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------- 调试串口（板载 USB 转串口，115200 8N1）----------------
IO_LOC  "o_uart_tx" M15;
IO_PORT "o_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "i_uart_rx" J21;
IO_PORT "i_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------- 遥控接收机：J6六路均接入 ----------------
// i_rc_pwm[i]对应J6.(i+1)，完整CH映射及方向配置见HT10A接线文档。
IO_LOC  "i_rc_pwm[0]" D19;                                 // J6.1  CH4 转向（左摇杆左右）
IO_PORT "i_rc_pwm[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_rc_pwm[1]" E19;                                 // J6.2  CH2 油门（右摇杆上下；兼菜单上下拨动）
IO_PORT "i_rc_pwm[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_rc_pwm[2]" E18;                                 // J6.3  CH5/SWA 下确认、上返回
IO_PORT "i_rc_pwm[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_rc_pwm[3]" F18;                                 // J6.4  CH7/SWC 手动/光标
IO_PORT "i_rc_pwm[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_rc_pwm[4]" F20;                                 // J6.5  CH6/SWB AI录音
IO_PORT "i_rc_pwm[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_rc_pwm[5]" F19;                                 // J6.6  CH8/SWD/select 子菜单选择
IO_PORT "i_rc_pwm[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------- 电机驱动（WHEELTEC D24A，J4/J5 排线直连）----------------
// 通道顺序：0=A 左前  1=B 右前  2=C 左后  3=D 右后（与本车极性标定一致）
IO_LOC  "o_stby" A19;
IO_PORT "o_stby" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "o_motor_in1[0]" B13;                              // J4 pin8  AIN1 - J1.27
IO_PORT "o_motor_in1[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_in2[0]" E14;                              // J4 pin6  AIN2 - J1.31
IO_PORT "o_motor_in2[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_pwm[0]" F14;                              // J4 pin4  PWMA - J1.33
IO_PORT "o_motor_pwm[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "o_motor_in1[1]" E13;                              // J4 pin7  BIN1 - J1.32
IO_PORT "o_motor_in1[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_in2[1]" F13;                              // J4 pin5  BIN2 - J1.34
IO_PORT "o_motor_in2[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_pwm[1]" A18;                              // J4 pin3  PWMB - J1.36
IO_PORT "o_motor_pwm[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "o_motor_in1[2]" D16;                              // J5 pin8  CIN1 - J1.17
IO_PORT "o_motor_in1[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_in2[2]" C17;                              // J5 pin6  CIN2 - J1.19
IO_PORT "o_motor_in2[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_pwm[2]" B16;                              // J5 pin4  PWMC - J1.21
IO_PORT "o_motor_pwm[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "o_motor_in1[3]" E16;                              // J5 pin7  DIN1 - J1.18
IO_PORT "o_motor_in1[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_in2[3]" D17;                              // J5 pin5  DIN2 - J1.20
IO_PORT "o_motor_in2[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_motor_pwm[3]" B15;                              // J5 pin3  PWMD - J1.22
IO_PORT "o_motor_pwm[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

// ---------------- 编码器 A/B ×4 ----------------
// 注意：C17 C18 C19 D17 B17 B18 带时钟能力（MGCLK*/SGCLK*/RPLL*），
//       这里当普通 IO 用（实现允许）；将来要外部时钟只能另想办法
IO_LOC  "i_enc_a[0]" D15;
IO_PORT "i_enc_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_enc_b[0]" C15;
IO_PORT "i_enc_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_enc_a[1]" C13;
IO_PORT "i_enc_a[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_enc_b[1]" D14;
IO_PORT "i_enc_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_enc_a[2]" B18;
IO_PORT "i_enc_a[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_enc_b[2]" C19;
IO_PORT "i_enc_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_enc_a[3]" B17;
IO_PORT "i_enc_a[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_enc_b[3]" C18;
IO_PORT "i_enc_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------- HDMI 输出（板载 HDMI 1 接口，DVI_TX_Top 内部建 LVDS25）----------------
IO_LOC  "o_tmds_clk_p"  K4;
IO_LOC  "o_tmds_clk_n"  J4;
IO_LOC  "o_tmds_data_p[0]" L3;
IO_LOC  "o_tmds_data_n[0]" K3;
IO_LOC  "o_tmds_data_p[1]" L5;
IO_LOC  "o_tmds_data_n[1]" L4;
IO_LOC  "o_tmds_data_p[2]" M3;
IO_LOC  "o_tmds_data_n[2]" M2;

// ---------------- IMU660RA（J2 接口，SPI Mode0，四线）----------------
// J2 排针：VCC=5V、GND、SCL→A14、SDA→A13、SA0/SDO→A16、CS→A15
// ★ A15 就是 J2.6 = IMU CS，而 J1 与 J2 是同一条网络 ——
//   所以雷达 RX 只能用 C14（见下方"预留"段），两个输出挂一起会对打。
IO_LOC  "o_imu_sck" A14;                                   // J2 SCL → SPI SCK
IO_PORT "o_imu_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_imu_mosi" A13;                                  // J2 SDA → SPI MOSI
IO_PORT "o_imu_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "i_imu_miso" A16;                                  // J2 SDO/SA0 → SPI MISO
IO_PORT "i_imu_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "o_imu_cs_n" A15;                                  // J2 CS → SPI CS#
IO_PORT "o_imu_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---------------- 预留：雷达 / ToF ----------------
IO_LOC  "i_radar_rx" C14;                                  // J3.3 雷达 TX → 主板 RX（★ 不是 A15）
IO_PORT "i_radar_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ToF（J7 排针，I2C 接口）—— 2026-10-15 按手册 J7 表逐针核验后修正：
//   原先把 J7.3/J7.4（SDA/SCL）误当成"ToF 回波 + RK3588 串口"，语义错误，已改。
//   手册 J7 表：1 VIN/3V3、2 GND、3 SDA=E17、4 SCL=F16、5 INT=C20、6 SHUT=D20
IO_LOC  "o_tof_scl" F16;                                   // J7.4 SCL
IO_PORT "o_tof_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "io_tof_sda" E17;                                  // J7.3 SDA（I2C 双向）
IO_PORT "io_tof_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "i_tof_int" C20;                                   // J7.5 INT
IO_PORT "i_tof_int" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "o_tof_shut" D20;                                  // J7.6 SHUT
IO_PORT "o_tof_shut" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

// ---------------- LED0~LED7（高电平点亮）----------------
IO_LOC  "o_led[0]" M22;
IO_PORT "o_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_led[1]" N22;
IO_PORT "o_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_led[2]" L21;
IO_PORT "o_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_led[3]" K21;
IO_PORT "o_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_led[4]" K22;
IO_PORT "o_led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_led[5]" J22;
IO_PORT "o_led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_led[6]" H22;
IO_PORT "o_led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "o_led[7]" M21;
IO_PORT "o_led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ============================================================================
// 摄像头 OV5640(DVP) + DDR3 帧缓存 —— 2026-10-17 接入
//   引脚真源：**按模块示例**（需求方 2026-10-17："重新分配了摄像头引脚，请按示例的来"）
//     vendor\...\ov5640_capture\examples\acg720_ddr3_hdmi\constraints\
//     acg720_ov5640_ddr3_hdmi.cst  —— BY_OV5640_V1.1 2x9 直插接法，已在实板验证
//   数据通路：rtl\cam\cam_overlay.v（ov5640_capture -> ddr3_ctrl_2port -> 显示二选一）
//   ★ 注意与 doc\高云 ACG720-138&60K通用管脚分配表.xlsx 的差异：
//     官方表 COMS_XCLK=M17 / COMS_D0=J2；示例 data[0]=M17 / pclk=J2。
//     本工程采用【示例】映射，若要换回官方表接法，改这一段即可。
//   ★ COMS_XCLK 不接：示例模块自带 24 MHz 晶振，不需要 FPGA 供时钟。
//   ★ DDR3 45 针与官方表逐针一致（BA2=W1 / BA1=Y1 / BA0=U5 / CK_P=R3 ...）。
// ============================================================================
// ---- 摄像头接口（LVCMOS33）----
IO_LOC "camera_pwdn" L1;
IO_PORT "camera_pwdn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "camera_rst_n" B1;
IO_PORT "camera_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "camera_sclk" L18;
IO_PORT "camera_sclk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "camera_sdat" A1;
IO_PORT "camera_sdat" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "camera_data[7]" J1;
IO_PORT "camera_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_data[6]" G1;
IO_PORT "camera_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_data[5]" H2;
IO_PORT "camera_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_data[4]" F1;
IO_PORT "camera_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_data[3]" G2;
IO_PORT "camera_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_data[2]" D1;
IO_PORT "camera_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_data[1]" E1;
IO_PORT "camera_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_data[0]" M17;
IO_PORT "camera_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_pclk" J2;
IO_PORT "camera_pclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_href" B2;
IO_PORT "camera_href" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "camera_vsync" M20;
IO_PORT "camera_vsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// ---- DDR3 帧缓存（SSTL15 / BANK_VCCIO=1.5）----
IO_LOC "O_ddr_ba[2]" W1;
IO_PORT "O_ddr_ba[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_ba[1]" Y1;
IO_PORT "O_ddr_ba[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_ba[0]" U5;
IO_PORT "O_ddr_ba[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[13]" T6;
IO_PORT "O_ddr_addr[13]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[12]" W2;
IO_PORT "O_ddr_addr[12]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[11]" R4;
IO_PORT "O_ddr_addr[11]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[10]" AA6;
IO_PORT "O_ddr_addr[10]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[9]" U6;
IO_PORT "O_ddr_addr[9]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[8]" U3;
IO_PORT "O_ddr_addr[8]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[7]" R6;
IO_PORT "O_ddr_addr[7]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[6]" T1;
IO_PORT "O_ddr_addr[6]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[5]" T5;
IO_PORT "O_ddr_addr[5]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[4]" U1;
IO_PORT "O_ddr_addr[4]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[3]" T4;
IO_PORT "O_ddr_addr[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[2]" V3;
IO_PORT "O_ddr_addr[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[1]" U2;
IO_PORT "O_ddr_addr[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
