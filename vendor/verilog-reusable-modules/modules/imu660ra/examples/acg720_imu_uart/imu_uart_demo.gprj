<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW5AT-138B" pn="GW5AT-LV138PG484AC1/I0">gw5at138b-012</Device>
    <FileList>
        <!-- 模块库公共模块 -->
        <File path="../../../sync_fifo/rtl/sync_fifo.v" type="file.verilog" enable="1"/>
        <File path="../../../uart/rtl/uart_byte_tx.v" type="file.verilog" enable="1"/>
        <File path="../../../uart/rtl/uart_tx_queue.v" type="file.verilog" enable="1"/>
        <!-- IMU660RA 模块 -->
        <File path="../../rtl/spi_master_mode0.v" type="file.verilog" enable="1"/>
        <File path="../../rtl/bmi270_cfg_rom.v" type="file.verilog" enable="1"/>
        <File path="../../rtl/imu_top.v" type="file.verilog" enable="1"/>
        <!-- 本示例 -->
        <File path="uart_report.v" type="file.verilog" enable="1"/>
        <File path="imu_uart_top.v" type="file.verilog" enable="1"/>
        <File path="acg720_imu_uart.cst" type="file.cst" enable="1"/>
        <File path="acg720_imu_uart.sdc" type="file.sdc" enable="1"/>
    </FileList>
</Project>
