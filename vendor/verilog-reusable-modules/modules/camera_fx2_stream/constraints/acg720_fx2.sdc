// Contract: FX2 firmware supplies 48 MHz synchronous IFCLK.
create_clock -name fx2_ifclk -period 20.833 [get_ports {fx2_ifclk}]
// Capture/USB CDC uses owner toggles and stable bundled RAM; never per-bit live sampling.
// Only first synchronizer stages are timing exceptions; bundle remains bounded.
set_false_path -to [get_pins {u_camera_fx2_stream/req_sync_0_s0/D u_camera_fx2_stream/ack_sync_0_s0/D}]
set_max_delay -from [get_regs {u_camera_fx2_stream/captured_sequence_0_s0 u_camera_fx2_stream/captured_sequence_1_s0 u_camera_fx2_stream/captured_sequence_2_s0 u_camera_fx2_stream/captured_sequence_3_s0 u_camera_fx2_stream/captured_sequence_4_s0 u_camera_fx2_stream/captured_sequence_5_s0 u_camera_fx2_stream/captured_sequence_6_s0 u_camera_fx2_stream/captured_sequence_7_s0 u_camera_fx2_stream/captured_sequence_8_s0 u_camera_fx2_stream/captured_sequence_9_s0 u_camera_fx2_stream/captured_sequence_10_s0 u_camera_fx2_stream/captured_sequence_11_s0 u_camera_fx2_stream/captured_sequence_12_s0 u_camera_fx2_stream/captured_sequence_13_s0 u_camera_fx2_stream/captured_sequence_14_s0 u_camera_fx2_stream/captured_sequence_15_s0 u_camera_fx2_stream/captured_sequence_16_s0 u_camera_fx2_stream/captured_sequence_17_s0 u_camera_fx2_stream/captured_sequence_18_s0 u_camera_fx2_stream/captured_sequence_19_s0 u_camera_fx2_stream/captured_sequence_20_s0 u_camera_fx2_stream/captured_sequence_21_s0 u_camera_fx2_stream/captured_sequence_22_s0 u_camera_fx2_stream/captured_sequence_23_s0 u_camera_fx2_stream/captured_sequence_24_s0 u_camera_fx2_stream/captured_sequence_25_s0 u_camera_fx2_stream/captured_sequence_26_s0 u_camera_fx2_stream/captured_sequence_27_s0 u_camera_fx2_stream/captured_sequence_28_s0 u_camera_fx2_stream/captured_sequence_29_s0 u_camera_fx2_stream/captured_sequence_30_s0 u_camera_fx2_stream/captured_sequence_31_s0}] -to [get_regs {u_camera_fx2_stream/usb_sequence_0_s0 u_camera_fx2_stream/usb_sequence_1_s0 u_camera_fx2_stream/usb_sequence_2_s0 u_camera_fx2_stream/usb_sequence_3_s0 u_camera_fx2_stream/usb_sequence_4_s0 u_camera_fx2_stream/usb_sequence_5_s0 u_camera_fx2_stream/usb_sequence_6_s0 u_camera_fx2_stream/usb_sequence_7_s0 u_camera_fx2_stream/usb_sequence_8_s0 u_camera_fx2_stream/usb_sequence_9_s0 u_camera_fx2_stream/usb_sequence_10_s0 u_camera_fx2_stream/usb_sequence_11_s0 u_camera_fx2_stream/usb_sequence_12_s0 u_camera_fx2_stream/usb_sequence_13_s0 u_camera_fx2_stream/usb_sequence_14_s0 u_camera_fx2_stream/usb_sequence_15_s0 u_camera_fx2_stream/usb_sequence_16_s0 u_camera_fx2_stream/usb_sequence_17_s0 u_camera_fx2_stream/usb_sequence_18_s0 u_camera_fx2_stream/usb_sequence_19_s0 u_camera_fx2_stream/usb_sequence_20_s0 u_camera_fx2_stream/usb_sequence_21_s0 u_camera_fx2_stream/usb_sequence_22_s0 u_camera_fx2_stream/usb_sequence_23_s0 u_camera_fx2_stream/usb_sequence_24_s0 u_camera_fx2_stream/usb_sequence_25_s0 u_camera_fx2_stream/usb_sequence_26_s0 u_camera_fx2_stream/usb_sequence_27_s0 u_camera_fx2_stream/usb_sequence_28_s0 u_camera_fx2_stream/usb_sequence_29_s0 u_camera_fx2_stream/usb_sequence_30_s0 u_camera_fx2_stream/usb_sequence_31_s0}] 20.000
// PROVISIONAL 5 ns I/O budget, not derived timing sign-off: verify FX2 electrical specs/board at PnR.
set_input_delay -clock fx2_ifclk -max 5.000 [get_ports {fx2_flagc}]
set_input_delay -clock fx2_ifclk -min 0.000 [get_ports {fx2_flagc}]
set_output_delay -clock fx2_ifclk -max 5.000 [get_ports {fx2_fd[*] fx2_faddr[*] fx2_slwr_n fx2_pktend_n fx2_slcs_n fx2_sloe_n fx2_slrd_n}]
set_output_delay -clock fx2_ifclk -min 0.000 [get_ports {fx2_fd[*] fx2_faddr[*] fx2_slwr_n fx2_pktend_n fx2_slcs_n fx2_sloe_n fx2_slrd_n}]
