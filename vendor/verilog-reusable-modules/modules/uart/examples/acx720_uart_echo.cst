// ACX720 / GW5AT-138B回显示例管脚约束
IO_LOC "i_clock" Y18;
IO_PORT "i_clock" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "i_reset_n" F15;
IO_PORT "i_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "i_uart_rx" J21;
IO_PORT "i_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "o_uart_tx" M15;
IO_PORT "o_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "o_error_led" M22;
IO_PORT "o_error_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
