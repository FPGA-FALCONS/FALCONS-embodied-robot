// Four-axis receiver bring-up through 5V/3.3V level conversion.
// Verified adapter Rev I p5: J6 CH1/D19, CH2/E19, CH3/E18, CH4/F18.
// Bank2 actual VCCIO must be 3.3V. rc_pwm inputs connect only to LV1..LV4.
// Clock/S4/SW0/HC595/LED mappings from official ACG720 sources.
IO_LOC "clk" Y18;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rst_n" B21;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "sw0" G22;
IO_PORT "sw0" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "rc_pwm[0]" D19;
IO_PORT "rc_pwm[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "rc_pwm[1]" E19;
IO_PORT "rc_pwm[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "rc_pwm[2]" E18;
IO_PORT "rc_pwm[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "rc_pwm[3]" F18;
IO_PORT "rc_pwm[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "ds" M18;
IO_PORT "ds" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "sh_cp" F4;
IO_PORT "sh_cp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "st_cp" C2;
IO_PORT "st_cp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[0]" M22;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" N22;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[2]" L21;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[3]" K21;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[4]" K22;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[5]" J22;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[6]" H22;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[7]" M21;
IO_PORT "led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
