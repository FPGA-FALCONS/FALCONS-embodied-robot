// ui_text_index.vh —— UI 文案的地址/长度索引（由 tools/gen_font_rom.py 自动生成，请勿手改）
//
// 用法：text_renderer 用 UI_TXT_<名>_ADDR / UI_TXT_<名>_LEN 从 ui_text_rom 取字符索引，
//       再用 char_index*16+row 从 font_rom（16x16）取 16bit 行点阵，
//       或 char_index*24+row 从 font_rom_lg（24x24）取 24bit 行点阵。

localparam integer UI_FONT_CHAR_COUNT = 233;
localparam integer UI_TEXT_TOTAL_CHARS = 269;

// {名, 文案, 起始地址, 字符数}
